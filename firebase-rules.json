{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": true,
      "$uid": {
        ".write": true,
        ".validate": "$uid.length < 40"
      }
    },
    "lobby": {
      ".read": true,
      "$room": {
        ".write": true,
        ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 30 && newData.child('max').isNumber() && newData.child('max').val() <= 6)"
      }
    },
    "stats": {
      ".read": true,
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['p', 'at', 'map']) && newData.child('map').isString() && newData.child('map').val().length <= 30"
      }
    },
    "rooms": {
      "$room": {
        ".read": true,
        ".write": true,
        "chat": {
          "$msg": {
            ".validate": "!newData.exists() || (newData.child('t').isString() && newData.child('t').val().length <= 100)"
          }
        },
        "players": {
          "$uid": {
            ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length <= 20)"
          }
        }
      }
    }
  }
}
